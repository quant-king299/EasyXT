# ============================================
# Tushare 数据下载配置
# ============================================
# Tushare Pro Token (选填，如果使用Tushare数据源)
# 获取地址：https://tushare.pro/user/token
TUSHARE_TOKEN=your_tushare_token_here

# Tushare 备用Token (选填，限流时自动切换)
# 当主token被限流时会自动使用此token重试
TUSHARE_TOKEN_2=

# ============================================
# 数据存储路径配置
# ============================================
# 数据根目录（所有数据的存储位置）
# Windows示例：D:/StockData 或 E:/Data/Stock
# Linux/Mac示例：~/StockData 或 /mnt/data/Stock
# 说明：修改此路径后，所有数据都会存储在新位置
STOCK_DATA_ROOT=D:/StockData

# DuckDB 数据库路径（自动使用STOCK_DATA_ROOT）
# 一般不需要单独设置，会自动使用：{STOCK_DATA_ROOT}/stock_data.ddb
DUCKDB_PATH=D:/StockData/stock_data.ddb

# ============================================
# 雪球跟单配置
# ============================================
# 雪球登录Cookie（使用雪球跟单策略时必填）
# 获取方式：
#   1. 浏览器访问 https://xueqiu.com 并登录
#   2. F12 打开开发者工具 → 网络(Network)标签
#   3. 刷新页面，点击任意 xueqiu.com 请求
#   4. 在请求头中复制完整 Cookie 值
# 注意：Cookie 有时效性，过期后需重新获取
XUEQIU_COOKIE=

# ============================================
# QMT 交易配置（实盘必填）
# ============================================
# QMT 用户数据目录（userdata_mini 路径，连接交易端必需）
# Windows 示例：D:\国金QMT交易端模拟\userdata_mini
# 注意：路径需包含 userdata_mini 子目录
QMT_DATA_DIR=D:\国金QMT交易端模拟\userdata_mini

# QMT 交易账户 ID（实盘必填）
# 模拟盘通常为 8 位数字，可在 QMT 客户端 → 交易 → 资金账户 中查看
QMT_ACCOUNT_ID=

# QMT 用户数据路径（可选，与 QMT_DATA_DIR 二选一即可）
# QMT_USERDATA_PATH=

# ============================================
# miniQMT 自动登录配置
# ============================================
# QMT 可执行文件路径（XtMiniQmt.exe 完整路径）
# Windows 示例：D:\国金QMT交易端模拟\bin.x64\XtMiniQmt.exe
QMT_EXE_PATH=D:\国金QMT交易端模拟\bin.x64\XtMiniQmt.exe

# QMT 登录密码
# ⚠️ 安全提醒：密码将以明文存储在 .env 文件中
# 建议：
#   1. 不要在共享计算机上使用此功能
#   2. 定期修改密码
# 注意：用户ID会自动显示，无需填写
QMT_PASSWORD=

# 大QMT 可执行文件路径（XtItClient.exe 完整路径，用于信号桥接检测）
# 大QMT 是完整版 QMT 客户端，miniQMT 是极简版
# 两者共享同一后端，登录一个即可
# Windows 示例：D:\国金QMT交易端模拟\bin.x64\XtItClient.exe
QMT_EXE_PATH_BIG=D:\国金QMT交易端模拟\bin.x64\XtItClient.exe

# ============================================
# 大QMT 信号桥接配置
# ============================================
# 信号桥接目录（大QMT和Python都能访问的共享文件夹）
# 当 miniQMT 不可用时，交易指令通过文件信号传递给大QMT
# 大QMT 接收器（qmt_signal_receiver_for_qmt.py）每 3 秒扫描此目录
# Windows 示例：D:/QMT_SIGNALS
QMT_SIGNAL_DIR=D:/QMT_SIGNALS

# ============================================
# 通达信数据配置
# ============================================
# 通达信安装目录（PYPlugins 路径，用于数据获取）
# Windows 示例：C:\new_tdx64 或 D:\new_tdx64
# 注意：路径需指向通达信安装根目录，不包含 PYPlugins
# 说明：EasyXT 将自动拼接 PYPlugins/user 来访问插件
TDX_PATH=C:\new_tdx64

# ============================================
# xqshare 跨平台配置（Mac/Linux 远程连接 Windows QMT）
# ============================================
# xqshare 远程服务器 IP 地址（运行 QMT 的 Windows 机器 IP）
# 配置后 EasyXT 会自动通过 xqshare 远程获取数据和执行交易
# 前置条件：
#   1. Ubuntu/Mac 端：pip install xqshare
#   2. Windows 端：pip install xqshare 并启动 xqshare 服务端
#   3. Windows 端 QMT 已启动并登录
XQSHARE_REMOTE_HOST=
XQSHARE_REMOTE_PORT=18812

# ============================================
# EasyXT Data Node 配置（跨平台投研/回测数据访问）
# ============================================
# Windows 服务端：
#   通常不需要在 .env 中填写下面这些客户端地址配置。
#   直接运行启动脚本即可，脚本已有通用默认值：
#   .\deploy\start_data_node_windows.ps1
#
# Mac/Linux 客户端：
#   需要在自己的 .env 中填写 EASYXT_DATA_NODE_HOST，
#   也可以填写 SMB 挂载信息，方便记录当前连接的是哪台 Windows 数据节点。
#   配好后可检查：
#   python tools/check_data_node.py
#
# 示例值仅供参考，请不要把个人真实 IP/用户名提交到仓库。
EASYXT_DATA_NODE_HOST=192.168.1.100
EASYXT_DATA_SERVICE_HOST=0.0.0.0
EASYXT_DATA_SERVICE_PORT=18820
EASYXT_DATA_NODE_ID=win_data_node_1
EASYXT_DATA_NODE_SMB_MOUNT=/Volumes/EasyXT
EASYXT_DATA_NODE_SMB_SOURCE=//user@windows-host/EasyXT

# ============================================
# GUI 界面配置
# ============================================
# 部分机器上 QMT (xtquant) 先占用 COM 多线程模式，导致 GUI
# 中打开文件选择对话框时崩溃（OleInitialize 报错）。
# 设置 QT_NO_NATIVE_DIALOG=1 可切换到 Qt 自带对话框规避。
# 默认不设置（使用 Windows 原生对话框），界面无变化。
QT_NO_NATIVE_DIALOG=


